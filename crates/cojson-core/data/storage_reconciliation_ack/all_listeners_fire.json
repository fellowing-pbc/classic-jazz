{
  "description": "every wait registered for a batch fires on ack, in registration order",
  "ops": [
    {
      "op": "trackBatch",
      "batchId": "batch-1",
      "peerId": "peer-1",
      "nextOffset": 50
    },
    {
      "op": "waitForAck",
      "batchId": "batch-1",
      "peerId": "peer-1",
      "waitId": 1
    },
    {
      "op": "waitForAck",
      "batchId": "batch-1",
      "peerId": "peer-1",
      "waitId": 2
    },
    {
      "op": "handleAck",
      "batchId": "batch-1",
      "peerId": "peer-1"
    }
  ],
  "expected": {
    "eventLog": [
      "offset:50",
      "ack:1",
      "ack:2"
    ],
    "pending": []
  }
}