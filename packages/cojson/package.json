{
  "name": "cojson",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node/NapiNode": {
      "types": "./dist/node/NapiNode.d.ts",
      "default": "./dist/node/NapiNode.js"
    },
    "./node/WasmNode": {
      "types": "./dist/node/WasmNode.d.ts",
      "default": "./dist/node/WasmNode.js"
    },
    "./node/WasmNode/edge": {
      "types": "./dist/node/WasmNodeEdge.d.ts",
      "default": "./dist/node/WasmNodeEdge.js"
    },
    "./node/RNNode": {
      "types": "./dist/node/RNNode.d.ts",
      "default": "./dist/node/RNNode.js"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "type": "module",
  "license": "MIT",
  "version": "0.20.18",
  "devDependencies": {
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "libsql": "^0.5.13",
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.1",
    "typescript": "catalog:default"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@opentelemetry/api": "^1.9.0",
    "@scure/base": "1.2.1",
    "cojson-core-wasm": "workspace:*",
    "cojson-core-napi": "workspace:*",
    "unicode-segmenter": "^0.12.0",
    "cojson-core-rn": "workspace:*"
  },
  "scripts": {
    "dev": "tsc --watch --sourceMap --outDir dist",
    "test": "vitest --run --root ../../ --project cojson",
    "test:watch": "vitest --watch --root ../../ --project cojson",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "build": "rm -rf ./dist && tsc --sourceMap --outDir dist"
  },
  "gitHead": "33c27053293b4801b968c61d5c4c989f93a67d13"
}
